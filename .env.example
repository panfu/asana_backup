# ===== Asana OAuth（在 https://app.asana.com/-/developer_console 创建 App 后填写）=====
# scope 需与 Developer Console 勾选一致，否则回调报 forbidden_scopes
ASANA_CLIENT_ID=
ASANA_CLIENT_SECRET=
ASANA_REDIRECT_URI=http://localhost:8600/oauth/callback
ASANA_SCOPES=tasks:read projects:read attachments:read users:read workspaces:read custom_fields:read

# ===== 开发模式（可选）=====
# OAuth 未配置时，填入 PAT 即可跳过 OAuth 本地联调（页面上会显示「开发模式」徽标）
ASANA_DEV_TOKEN=

# ===== 服务 =====
# SECRET_KEY 用于加密 OAuth token（python -m app.genkey 生成）
SECRET_KEY=
BASE_URL=http://localhost:8600
DATA_DIR=./data

# ===== 生命周期（小时）=====
ZIP_TTL_HOURS=3
JOB_RECORD_TTL_HOURS=24

# ===== Asana API 行为（沿用 ~/ar/bridge 验证过的参数）=====
ASANA_BASE_URL=https://app.asana.com/api/1.0
ASANA_TIMEOUT=30
ASANA_RETRY_TIMES=3
ASANA_RATE_LIMIT=2

# ===== 导出安全上限 =====
MAX_TASKS_PER_EXPORT=5000
MAX_SUBTASKS_PER_TASK=50
MAX_SUBTASK_DEPTH=3
MAX_ATTACHMENT_MB=200
